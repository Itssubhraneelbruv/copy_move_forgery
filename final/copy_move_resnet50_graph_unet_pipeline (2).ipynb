      "source": [
        "## 3. Graph module for copy-move similarity\n",
        "\n",
        "\n",
        "```text\n",
        "e_ij = similarity_ij + gamma * distance_ij\n",
        "p_ij = sigmoid(e_ij) * spatial_gate\n",
        "z_i  = [max(p_ij), mean(p_ij), fraction(p_ij > threshold)]\n",
        "```\n",
        "\n",
        "The spatial gate suppresses nearby texture continuity, so the graph focuses more on displaced copies rather than neighboring edges."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "5ed8faff",
      "metadata": {
        "id": "5ed8faff"
      },
      "outputs": [],
      "source": [
        "class SimilarityGraphBlock(tf.keras.layers.Layer):\n",
        "    \"\"\"\n",
        "    Graph block for copy-move detection.\n",
        "\n",
        "    Per edge i -> j:\n",
        "        e_ij  = s_ij + gamma * d_ij\n",
        "        gate  = (d_ij > near_thresh)\n",
        "        p_ij  = sigmoid(e_ij) * gate\n",
        "        z_i   = [max(p_ij), mean(p_ij), frac(p_ij > threshold)]\n",
        "\n",
        "    It returns:\n",
        "        out   : refined feature tensor with graph evidence fused back in\n",
        "        z_map : 3-channel graph evidence map\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, top_k=8, near_thresh=0.15, threshold=0.70,\n",
        "                 max_nodes=1024, **kwargs):\n",
        "        super().__init__(**kwargs)\n",
        "        self.top_k = top_k\n",
        "        self.near_thresh = near_thresh\n",
        "        self.threshold = threshold\n",
        "        self.max_nodes = max_nodes\n",
        "\n",
        "    def build(self, input_shape):\n",
        "        channels = int(input_shape[-1])\n",
        "        self.gamma_raw = self.add_weight(\n",
        "            name=\"gamma_raw\",\n",
        "            shape=(),\n",
        "            trainable=True,\n",
        "            initializer=tf.keras.initializers.Constant(0.5)\n",
        "        )\n",
        "        self.graph_to_feat = tf.keras.layers.Conv2D(\n",
        "            channels, 1, padding=\"same\", activation=\"relu\", name=\"graph_to_feat\"\n",
        "        )\n",
        "        self.gate_conv = tf.keras.layers.Conv2D(\n",
        "            channels, 1, padding=\"same\", activation=\"sigmoid\", name=\"graph_gate\"\n",
        "        )\n",
        "        self.refine = tf.keras.layers.Conv2D(\n",
        "            channels, 3, padding=\"same\", activation=\"relu\", name=\"graph_refine\"\n",
        "        )\n",
        "        super().build(input_shape)\n",
        "\n",
        "    def get_config(self):\n",
        "        cfg = super().get_config()\n",
        "        cfg.update({\n",
        "            \"top_k\": self.top_k,\n",
        "            \"near_thresh\": self.near_thresh,\n",
        "            \"threshold\": self.threshold,\n",
        "            \"max_nodes\": self.max_nodes,\n",
        "        })\n",
        "        return cfg\n",
        "\n",
        "    def _maybe_pool(self, x):\n",
        "        h, w = x.shape[1], x.shape[2]\n",
        "        if h is None or w is None:\n",
        "            return x, 1\n",
        "\n",
        "        pool = 1\n",
        "        while (math.ceil(h / pool) * math.ceil(w / pool)) > self.max_nodes:\n",
        "            pool *= 2\n",
        "\n",
        "        if pool > 1:\n",
        "            return tf.nn.avg_pool2d(x, ksize=pool, strides=pool, padding=\"SAME\"), pool\n",
        "        return x, 1\n",
        "\n",
        "    def call(self, x):\n",
        "        x_small, pool = self._maybe_pool(x)\n",
        "\n",
        "        b = tf.shape(x_small)[0]\n",
        "        h = tf.shape(x_small)[1]\n",
        "        w = tf.shape(x_small)[2]\n",
        "        c = tf.shape(x_small)[3]\n",
        "        n = h * w\n",
        "\n",
        "        nodes = tf.reshape(x_small, [b, n, c])\n",
        "        nodes = tf.math.l2_normalize(nodes, axis=-1)\n",
        "\n",
        "        # Cosine similarity matrix: [B, N, N]\n",
        "        sim = tf.matmul(nodes, nodes, transpose_b=True)\n",
        "\n",
        "        # Remove self connections.\n",
        "        sim = sim - 2.0 * tf.eye(n, batch_shape=[b], dtype=sim.dtype)\n",
        "\n",
        "        h_s = x_small.shape[1] or tf.shape(x_small)[1]\n",
        "        w_s = x_small.shape[2] or tf.shape(x_small)[2]\n",
        "        n_s = (h_s * w_s) if (x_small.shape[1] is not None) else n\n",
        "        k = min(self.top_k, max(int(n_s) - 1, 1)) if isinstance(n_s, int) else self.top_k\n",
        "\n",
        "        topk = tf.math.top_k(sim, k=k, sorted=False)\n",
        "        sim_topk = topk.values\n",
        "        idx_topk = topk.indices\n",
        "\n",
        "        # Normalized spatial coordinates.\n",
        "        denom_h = tf.maximum(tf.cast(h - 1, tf.float32), 1.0)\n",
        "        denom_w = tf.maximum(tf.cast(w - 1, tf.float32), 1.0)\n",
        "\n",
        "        yy, xx = tf.meshgrid(\n",
        "            tf.range(h, dtype=tf.float32) / denom_h,\n",
        "            tf.range(w, dtype=tf.float32) / denom_w,\n",
        "            indexing=\"ij\"\n",
        "        )\n",
        "        coords = tf.reshape(tf.stack([yy, xx], axis=-1), [n, 2])\n",
        "\n",
        "        nbr_coords = tf.gather(coords, idx_topk)      # [N, k, 2]\n",
        "        src_coords = coords[:, tf.newaxis, :]         # [N, 1, 2]\n",
        "        d = tf.norm(src_coords - nbr_coords, axis=-1) # [N, k]\n",
        "        d = d / math.sqrt(2.0)\n",
        "\n",
        "        gamma = tf.nn.softplus(self.gamma_raw)\n",
        "        e = sim_topk + gamma * d\n",
        "\n",
        "        spatial_gate = tf.cast(d > self.near_thresh, tf.float32)\n",
        "        p = tf.sigmoid(e) * spatial_gate\n",
        "\n",
        "        z_max = tf.reduce_max(p, axis=-1, keepdims=True)\n",
        "        z_mean = tf.reduce_mean(p, axis=-1, keepdims=True)\n",
        "        z_count = tf.reduce_mean(\n",
        "            tf.cast(p > self.threshold, tf.float32),\n",
        "            axis=-1,\n",
        "            keepdims=True\n",
        "        )\n",
        "\n",
        "        z = tf.concat([z_max, z_mean, z_count], axis=-1)\n",
        "        z_map = tf.reshape(z, [b, h, w, 3])\n",
        "\n",
        "        if pool > 1:\n",
        "            z_map = tf.image.resize(\n",
        "                z_map,\n",
        "                size=(tf.shape(x)[1], tf.shape(x)[2]),\n",
        "                method=\"bilinear\"\n",
        "            )\n",
        "\n",
        "        graph_feat = self.graph_to_feat(z_map)\n",
        "        fused = tf.concat([x, graph_feat], axis=-1)\n",
        "        gate = self.gate_conv(fused)\n",
        "        out = x + gate * graph_feat\n",
        "        out = self.refine(out)\n",
        "\n",
        "        return out, z_map\n"
      ]
    },
