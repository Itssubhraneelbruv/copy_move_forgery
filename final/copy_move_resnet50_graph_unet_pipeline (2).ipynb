      "source": [
        "## 8. SWT edge maps"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "dd35c6c4",
      "metadata": {
        "id": "dd35c6c4"
      },
      "outputs": [],
      "source": [
        "def swt_edge_map(img, wavelet=\"haar\", level=2):\n",
        "    if img.ndim == 3:\n",
        "        img = img[..., 0]\n",
        "    img = img.astype(np.float32)\n",
        "    H, W = img.shape\n",
        "    mult = 2 ** level\n",
        "    pad_h = (mult - H % mult) % mult\n",
        "    pad_w = (mult - W % mult) % mult\n",
        "    padded = np.pad(img, ((0, pad_h), (0, pad_w)), mode=\"reflect\")\n",
        "    coeffs = pywt.swt2(padded, wavelet=wavelet, level=level)\n",
        "    cA2, (cH2, cV2, cD2) = coeffs[0]\n",
        "    edge = np.sqrt(cH2 ** 2 + cV2 ** 2 + cD2 ** 2)[:H, :W]\n",
        "    edge = np.nan_to_num(edge)\n",
        "    edge = edge - edge.min()\n",
        "    if edge.max() > 1e-8:\n",
        "        edge = edge / edge.max()\n",
        "    return edge[..., None].astype(np.float32)\n",
        "\n",
        "\n",
        "def extract_swt_edges(X_batch):\n",
        "    edges = []\n",
        "    for i, img in enumerate(X_batch):\n",
        "        edges.append(swt_edge_map(img))\n",
        "        if (i + 1) % 500 == 0:\n",
        "            print(f\"Processed {i + 1}/{len(X_batch)}\")\n",
        "    return np.array(edges, dtype=np.float32)"
      ]
    },
