      "source": [
        "# Optional classifier fine-tuning: unfreeze only conv5 stage of ResNet50 classifier backbone.\n",
        "# This does NOT fine-tune the U-Net; the segmentation masks remain fixed.\n",
        "\n",
        "backbone = cls_model.get_layer(\"resnet50\")\n",
        "backbone.trainable = True\n",
        "for layer in backbone.layers:\n",
        "    layer.trainable = layer.name.startswith(\"conv5_\")\n",
        "\n",
        "cls_model.compile(\n",
        "    optimizer=tf.keras.optimizers.Adam(learning_rate=1e-5, clipnorm=1.0),\n",
        "    loss=\"binary_crossentropy\",\n",
        "    metrics=[\"accuracy\", tf.keras.metrics.AUC(name=\"auc\"), tf.keras.metrics.Precision(name=\"precision\"), tf.keras.metrics.Recall(name=\"recall\")]\n",
        ")\n",
        "\n",
        "callbacks_cls_stage2 = [\n",
        "    tf.keras.callbacks.ModelCheckpoint(\n",
        "        \"resnet50_cm_classifier_best.keras\", monitor=\"val_auc\", mode=\"max\",\n",
        "        save_best_only=True, verbose=1\n",
        "    ),\n",
        "    tf.keras.callbacks.EarlyStopping(\n",
        "        monitor=\"val_auc\", mode=\"max\", patience=5, restore_best_weights=True\n",
        "    )\n",
        "]\n",
        "\n",
        "history_cls_stage2 = cls_model.fit(\n",
        "    [X_train, pred_mask_train, X_cm_train, X_swt_train, X_cm_stats_train],\n",
        "    y_train_cls,\n",
        "    validation_split=0.1,\n",
        "    batch_size=8,\n",
        "    epochs=10,\n",
        "    callbacks=callbacks_cls_stage2\n",
        ")"
      ]
    },
