      "source": [
        "## 7. Displacement-consistent SIFT copy-move heatmap\n",
        "\n",
        "This generates a map that lights up only when keypoint matches agree on a consistent movement vector `(dx, dy)`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "43c846a4",
      "metadata": {
        "id": "43c846a4"
      },
      "outputs": [],
      "source": [
        "def copy_move_sift_hough_heatmap(\n",
        "    image_uint8, min_dist_px=40, ratio_thresh=0.80,\n",
        "    bin_size=8, min_cluster_votes=3, blur_ksize=21\n",
        "):\n",
        "    if image_uint8.ndim == 3:\n",
        "        image_uint8 = image_uint8[..., 0]\n",
        "\n",
        "    h, w = image_uint8.shape\n",
        "    heatmap = np.zeros((h, w), dtype=np.float32)\n",
        "\n",
        "    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))\n",
        "    enhanced = clahe.apply(image_uint8)\n",
        "\n",
        "    sift = cv2.SIFT_create(nfeatures=0, contrastThreshold=0.02, edgeThreshold=10)\n",
        "    kps, descs = sift.detectAndCompute(enhanced, None)\n",
        "    if descs is None or len(kps) < 4:\n",
        "        return heatmap[..., None], np.array([0, 0, 0, 0], dtype=np.float32)\n",
        "\n",
        "    bf = cv2.BFMatcher(cv2.NORM_L2)\n",
        "    matches = bf.knnMatch(descs, descs, k=3)\n",
        "\n",
        "    valid = []\n",
        "    for m_list in matches:\n",
        "        if len(m_list) < 3:\n",
        "            continue\n",
        "        m0, m1, m2 = m_list\n",
        "        if m1.queryIdx == m1.trainIdx:\n",
        "            continue\n",
        "        if m2.distance < 1e-6:\n",
        "            continue\n",
        "        if m1.distance >= ratio_thresh * m2.distance:\n",
        "            continue\n",
        "\n",
        "        x1, y1 = kps[m1.queryIdx].pt\n",
        "        x2, y2 = kps[m1.trainIdx].pt\n",
        "        if math.hypot(x1 - x2, y1 - y2) < min_dist_px:\n",
        "            continue\n",
        "\n",
        "        dx, dy = x2 - x1, y2 - y1\n",
        "        if dx < 0:\n",
        "            dx, dy = -dx, -dy\n",
        "            x1, y1, x2, y2 = x2, y2, x1, y1\n",
        "\n",
        "        weight = 1.0 / (m1.distance + 1e-6)\n",
        "        valid.append((x1, y1, x2, y2, dx, dy, weight))\n",
        "\n",
        "    if len(valid) == 0:\n",
        "        return heatmap[..., None], np.array([0, 0, 0, 0], dtype=np.float32)\n",
        "\n",
        "    bins = {}\n",
        "    for item in valid:\n",
        "        x1, y1, x2, y2, dx, dy, weight = item\n",
        "        key = (int(round(dx / bin_size)), int(round(dy / bin_size)))\n",
        "        bins.setdefault(key, []).append(item)\n",
        "\n",
        "    strong_clusters = [cluster for cluster in bins.values() if len(cluster) >= min_cluster_votes]\n",
        "    if len(strong_clusters) == 0:\n",
        "        return heatmap[..., None], np.array([len(valid), 0, 0, 0], dtype=np.float32)\n",
        "\n",
        "    strongest_cluster_size = max(len(c) for c in strong_clusters)\n",
        "    total_clustered_matches = 0\n",
        "    total_weight = 0.0\n",
        "\n",
        "    for cluster in strong_clusters:\n",
        "        cluster_strength = len(cluster)\n",
        "        for x1, y1, x2, y2, dx, dy, weight in cluster:\n",
        "            total_clustered_matches += 1\n",
        "            total_weight += weight\n",
        "            vote = weight * cluster_strength\n",
        "            for x, y in [(x1, y1), (x2, y2)]:\n",
        "                xi, yi = int(round(x)), int(round(y))\n",
        "                if 0 <= xi < w and 0 <= yi < h:\n",
        "                    heatmap[yi, xi] += vote\n",
        "\n",
        "    if blur_ksize is not None and blur_ksize > 1:\n",
        "        heatmap = cv2.GaussianBlur(heatmap, (blur_ksize, blur_ksize), 0)\n",
        "    if heatmap.max() > 1e-8:\n",
        "        heatmap = heatmap / heatmap.max()\n",
        "\n",
        "    stats = np.array([len(valid), total_clustered_matches, strongest_cluster_size, total_weight], dtype=np.float32)\n",
        "    return heatmap[..., None].astype(np.float32), stats\n",
        "\n",
        "\n",
        "def extract_copy_move_features(X_batch):\n",
        "    heatmaps, stats = [], []\n",
        "    for i, img in enumerate(X_batch):\n",
        "        gray = img[..., 0]\n",
        "        gray_uint8 = (np.clip(gray, 0, 1) * 255).astype(np.uint8)\n",
        "        hm, st = copy_move_sift_hough_heatmap(gray_uint8)\n",
        "        heatmaps.append(hm)\n",
        "        stats.append(st)\n",
        "        if (i + 1) % 250 == 0:\n",
        "            print(f\"Processed {i + 1}/{len(X_batch)}\")\n",
        "    return np.array(heatmaps, dtype=np.float32), np.array(stats, dtype=np.float32)"
      ]
    },
