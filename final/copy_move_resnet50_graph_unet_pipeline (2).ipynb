      "source": [
        "def plot_history(history, keys):\n",
        "    for key in keys:\n",
        "        if key in history.history:\n",
        "            plt.figure(figsize=(6, 4))\n",
        "            plt.plot(history.history[key], label=key)\n",
        "            val_key = f\"val_{key}\"\n",
        "            if val_key in history.history:\n",
        "                plt.plot(history.history[val_key], label=val_key)\n",
        "            plt.title(key)\n",
        "            plt.xlabel(\"Epoch\")\n",
        "            plt.legend()\n",
        "            plt.grid(True)\n",
        "            plt.show()\n",
        "\n",
        "print(\"Segmentation stage 1\")\n",
        "plot_history(history_seg_stage1, [\"loss\", \"dice_coef\", \"iou_coef\", \"precision\", \"recall\"])\n",
        "\n",
        "if \"history_seg_stage2\" in globals():\n",
        "    print(\"Segmentation stage 2\")\n",
        "    plot_history(history_seg_stage2, [\"loss\", \"dice_coef\", \"iou_coef\", \"precision\", \"recall\"])\n",
        "\n",
        "print(\"Classifier stage 1\")\n",
        "plot_history(history_cls_stage1, [\"loss\", \"accuracy\", \"auc\", \"precision\", \"recall\"])\n",
        "\n",
        "if \"history_cls_stage2\" in globals():\n",
        "    print(\"Classifier stage 2\")\n",
        "    plot_history(history_cls_stage2, [\"loss\", \"accuracy\", \"auc\", \"precision\", \"recall\"])"
