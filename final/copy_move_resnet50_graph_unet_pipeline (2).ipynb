      "source": [
        "def conv_bn_relu(x, filters, kernel_size=3, dropout=0.0, name=None):\n",
        "    x = tf.keras.layers.Conv2D(\n",
        "        filters, kernel_size, padding=\"same\", kernel_initializer=\"he_normal\",\n",
        "        use_bias=False, name=None if name is None else f\"{name}_conv\"\n",
        "    )(x)\n",
        "    x = tf.keras.layers.BatchNormalization(name=None if name is None else f\"{name}_bn\")(x)\n",
        "    x = tf.keras.layers.Activation(\"relu\", name=None if name is None else f\"{name}_relu\")(x)\n",
        "    if dropout and dropout > 0:\n",
        "        x = tf.keras.layers.Dropout(dropout, name=None if name is None else f\"{name}_drop\")(x)\n",
        "    return x\n",
        "\n",
        "\n",
        "def decoder_block(x, skip, filters, dropout=0.0, name=\"dec\"):\n",
        "    x = tf.keras.layers.Conv2DTranspose(filters, 2, strides=2, padding=\"same\", name=f\"{name}_up\")(x)\n",
        "    if skip is not None:\n",
        "        x = tf.keras.layers.Concatenate(name=f\"{name}_concat\")([x, skip])\n",
        "    x = conv_bn_relu(x, filters, 3, dropout=dropout, name=f\"{name}_conv1\")\n",
        "    x = conv_bn_relu(x, filters, 3, dropout=dropout, name=f\"{name}_conv2\")\n",
        "    return x\n",
        "\n",
        "\n",
        "def build_resnet50_graph_unet(img_h=512, img_w=512, img_c=1, encoder_trainable=False):\n",
        "\n",
        "    inputs = tf.keras.layers.Input((img_h, img_w, img_c), name=\"image_input\")\n",
        "\n",
        "    # grayscale -> 3 channels\n",
        "    x3 = tf.keras.layers.Concatenate(name=\"gray_to_rgb\")([inputs, inputs, inputs])\n",
        "\n",
        "    # ResNet50 preprocess_input expects roughly 0-255 input before mean subtraction.\n",
        "    x3 = tf.keras.layers.Lambda(\n",
        "        lambda t: tf.keras.applications.resnet50.preprocess_input(t * 255.0),\n",
        "        name=\"resnet50_preprocess\"\n",
        "    )(x3)\n",
        "\n",
        "    encoder = tf.keras.applications.ResNet50(\n",
        "        include_top=False,\n",
        "        weights=\"imagenet\",\n",
        "        input_tensor=x3\n",
        "    )\n",
        "    encoder.trainable = encoder_trainable\n",
        "\n",
        "    s1 = encoder.get_layer(\"conv1_relu\").output          # 256x256\n",
        "    s2 = encoder.get_layer(\"conv2_block3_out\").output    # 128x128\n",
        "    s3 = encoder.get_layer(\"conv3_block4_out\").output    # 64x64\n",
        "    s4 = encoder.get_layer(\"conv4_block6_out\").output    # 32x32\n",
        "    b  = encoder.get_layer(\"conv5_block3_out\").output    # 16x16\n",
        "\n",
        "    # Your graph block on the high-level skip map.\n",
        "    # This is where region-level similarity is still spatially detailed enough.\n",
        "    s4_graph, z_skip = SimilarityGraphBlock(\n",
        "        top_k=16,\n",
        "        near_thresh=0.15,\n",
        "        threshold=0.70,\n",
        "        max_nodes=1024,\n",
        "        name=\"graph_skip_conv4\"\n",
        "    )(s4)\n",
        "\n",
        "    # Your graph block at the bottleneck.\n",
        "    # This catches stronger semantic duplicate structure with lower memory cost.\n",
        "    b_graph, z_bottleneck = SimilarityGraphBlock(\n",
        "        top_k=8,\n",
        "        near_thresh=0.20,\n",
        "        threshold=0.70,\n",
        "        max_nodes=1024,\n",
        "        name=\"graph_bottleneck_conv5\"\n",
        "    )(b)\n",
        "\n",
        "    b_graph = conv_bn_relu(b_graph, 1024, 3, dropout=0.2, name=\"bottleneck_1\")\n",
        "    b_graph = conv_bn_relu(b_graph, 1024, 3, dropout=0.2, name=\"bottleneck_2\")\n",
        "\n",
        "    d1 = decoder_block(b_graph, s4_graph, 512, dropout=0.15, name=\"dec_32\")\n",
        "    d2 = decoder_block(d1,      s3,       256, dropout=0.10, name=\"dec_64\")\n",
        "    d3 = decoder_block(d2,      s2,       128, dropout=0.10, name=\"dec_128\")\n",
        "    d4 = decoder_block(d3,      s1,        64, dropout=0.05, name=\"dec_256\")\n",
        "    d5 = decoder_block(d4,      None,      32, dropout=0.05, name=\"dec_512\")\n",
        "\n",
        "    mask_out = tf.keras.layers.Conv2D(1, 1, activation=\"sigmoid\", name=\"mask_out\")(d5)\n",
        "\n",
        "    seg_model = tf.keras.Model(inputs, mask_out, name=\"resnet50_graph_unet_seg\")\n",
        "    full_model = tf.keras.Model(inputs, [mask_out, z_skip, z_bottleneck], name=\"resnet50_graph_unet_full\")\n",
        "    return seg_model, full_model\n",
        "\n",
        "\n",
        "seg_model, graph_debug_model = build_resnet50_graph_unet(\n",
        "    IMG_H, IMG_W, IMG_C, encoder_trainable=False\n",
        ")\n",
        "seg_model.summary()\n"
      ]
    },
