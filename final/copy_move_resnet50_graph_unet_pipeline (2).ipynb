      "source": [
        "y_prob = cls_model.predict(\n",
        "    [X_test, pred_mask_test, X_cm_test, X_swt_test, X_cm_stats_test],\n",
        "    batch_size=8\n",
        ").flatten()\n",
        "\n",
        "print(\"Test AUC:\", roc_auc_score(y_test_cls, y_prob))\n",
        "\n",
        "thresholds = np.arange(0.10, 0.91, 0.5)\n",
        "best_acc = None\n",
        "best_f1 = None\n",
        "for t in thresholds:\n",
        "    yp = (y_prob >= t).astype(np.int32)\n",
        "    acc = accuracy_score(y_test_cls, yp)\n",
        "    f1 = f1_score(y_test_cls, yp)\n",
        "    if best_acc is None or acc > best_acc[1]:\n",
        "        best_acc = (t, acc, f1)\n",
        "    if best_f1 is None or f1 > best_f1[2]:\n",
        "        best_f1 = (t, acc, f1)\n",
        "\n",
        "print(\"Best by accuracy: threshold, acc, f1 =\", best_acc)\n",
        "print(\"Best by F1      : threshold, acc, f1 =\", best_f1)\n",
        "\n",
        "best_t = best_f1[0]\n",
        "y_pred = (y_prob >= 0.5).astype(np.int32)\n",
        "cm = confusion_matrix(y_test_cls, y_pred)\n",
        "print(cm)\n",
        "ConfusionMatrixDisplay(cm, display_labels=[\"Authentic\", \"Forged\"]).plot(cmap=\"Blues\")\n",
        "plt.title(f\"Test Confusion Matrix, threshold={best_t:.2f}\")\n",
        "plt.show()\n",
        "print(classification_report(y_test_cls, y_pred, target_names=[\"Authentic\", \"Forged\"], digits=4))"
      ]
    },
