      "source": [
        "def per_image_dice_np(y_true, y_pred, threshold=0.5, smooth=1e-6):\n",
        "    yt = (y_true > 0.5).astype(np.float32).reshape(len(y_true), -1)\n",
        "    yp = (y_pred > threshold).astype(np.float32).reshape(len(y_pred), -1)\n",
        "    inter = np.sum(yt * yp, axis=1)\n",
        "    denom = np.sum(yt, axis=1) + np.sum(yp, axis=1)\n",
        "    return (2 * inter + smooth) / (denom + smooth)\n",
        "\n",
        "\n",
        "def evaluate_segmentation(seg_model, X_eval, y_eval, y_eval_cls, batch_size=4):\n",
        "    pred = seg_model.predict(X_eval, batch_size=batch_size)\n",
        "    d_all = per_image_dice_np(y_eval, pred, threshold=0.5)\n",
        "    forged = y_eval_cls == 1\n",
        "    authentic = y_eval_cls == 0\n",
        "\n",
        "    print(\"Prediction mean:\", float(pred.mean()))\n",
        "    print(\"Prediction max :\", float(pred.max()))\n",
        "    print(\"GT mean        :\", float(y_eval.mean()))\n",
        "    print(\"Mean Dice      :\", float(d_all.mean()))\n",
        "    print(\"Median Dice    :\", float(np.median(d_all)))\n",
        "    print(\"Forged Dice    :\", float(d_all[forged].mean()) if forged.any() else None)\n",
        "    print(\"Authentic Dice :\", float(d_all[authentic].mean()) if authentic.any() else None)\n",
        "    return pred, d_all\n",
        "\n",
        "pred_mask_test, dice_test = evaluate_segmentation(seg_model, X_test, y_test, y_test_cls)"
      ]
    },
