      "source": [
        "def spatial_pyramid_pool(x, levels=(1, 2, 4, 8), name=\"spp\"):\n",
        "    parts = []\n",
        "    h, w = x.shape[1], x.shape[2]\n",
        "    for level in levels:\n",
        "        pooled = tf.keras.layers.AveragePooling2D(\n",
        "            pool_size=(h // level, w // level),\n",
        "            strides=(h // level, w // level),\n",
        "            padding=\"valid\",\n",
        "            name=f\"{name}_{level}x{level}\"\n",
        "        )(x)\n",
        "        parts.append(tf.keras.layers.Flatten()(pooled))\n",
        "    return tf.keras.layers.Concatenate(name=f\"{name}_concat\")(parts)\n",
        "\n",
        "\n",
        "def build_resnet50_graph_copy_move_classifier(img_h=512, img_w=512):\n",
        "    image_input = tf.keras.layers.Input((img_h, img_w, 1), name=\"image_input\")\n",
        "    mask_input  = tf.keras.layers.Input((img_h, img_w, 1), name=\"mask_input\")\n",
        "    cm_input    = tf.keras.layers.Input((img_h, img_w, 1), name=\"copy_move_map\")\n",
        "    swt_input   = tf.keras.layers.Input((img_h, img_w, 1), name=\"swt_edge_map\")\n",
        "    stat_input  = tf.keras.layers.Input((4,), name=\"copy_move_stats\")\n",
        "\n",
        "    x3 = tf.keras.layers.Concatenate(axis=-1, name=\"resnet_input_3ch\")([image_input, mask_input, cm_input])\n",
        "    x3 = tf.keras.layers.Lambda(\n",
        "        lambda t: tf.keras.applications.resnet50.preprocess_input(t * 255.0),\n",
        "        name=\"classifier_resnet_preprocess\"\n",
        "    )(x3)\n",
        "\n",
        "    backbone = tf.keras.applications.ResNet50(include_top=False, weights=\"imagenet\", input_shape=(img_h, img_w, 3))\n",
        "    backbone.trainable = False\n",
        "\n",
        "    x = backbone(x3)\n",
        "    x = tf.keras.layers.GlobalAveragePooling2D(name=\"resnet_gap\")(x)\n",
        "    x = tf.keras.layers.Dropout(0.3)(x)\n",
        "\n",
        "    aux = tf.keras.layers.Concatenate(axis=-1, name=\"aux_maps\")([mask_input, cm_input, swt_input])\n",
        "    aux = tf.keras.layers.AveragePooling2D(pool_size=4, strides=4, name=\"aux_downsample\")(aux)\n",
        "    aux = tf.keras.layers.Conv2D(16, 3, padding=\"same\", activation=\"relu\", name=\"aux_conv1\")(aux)\n",
        "    aux = tf.keras.layers.Conv2D(16, 3, padding=\"same\", activation=\"relu\", name=\"aux_conv2\")(aux)\n",
        "    aux = spatial_pyramid_pool(aux, levels=(1, 2, 4, 8), name=\"aux_spp\")\n",
        "    aux = tf.keras.layers.Dense(128, activation=\"relu\", name=\"aux_dense\")(aux)\n",
        "    aux = tf.keras.layers.Dropout(0.3)(aux)\n",
        "\n",
        "    st = tf.keras.layers.BatchNormalization(name=\"stats_bn\")(stat_input)\n",
        "    st = tf.keras.layers.Dense(32, activation=\"relu\", name=\"stats_dense1\")(st)\n",
        "    st = tf.keras.layers.Dense(16, activation=\"relu\", name=\"stats_dense2\")(st)\n",
        "\n",
        "    z = tf.keras.layers.Concatenate(name=\"fusion\")([x, aux, st])\n",
        "    z = tf.keras.layers.Dense(256, activation=\"relu\", name=\"head_dense1\")(z)\n",
        "    z = tf.keras.layers.Dropout(0.4)(z)\n",
        "    z = tf.keras.layers.Dense(64, activation=\"relu\", name=\"head_dense2\")(z)\n",
        "    z = tf.keras.layers.Dropout(0.3)(z)\n",
        "    out = tf.keras.layers.Dense(1, activation=\"sigmoid\", name=\"cls_output\")(z)\n",
        "\n",
        "    return tf.keras.Model(\n",
        "        inputs=[image_input, mask_input, cm_input, swt_input, stat_input],\n",
        "        outputs=out,\n",
        "        name=\"resnet50_graph_copy_move_classifier\"\n",
        "    )\n",
        "\n",
        "cls_model = build_resnet50_graph_copy_move_classifier(IMG_H, IMG_W)\n",
        "cls_model.summary()"
      ]
